<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="18"
      prefWidth="800" prefHeight="650"
      style="-fx-background-color: #EAF4FF;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.BmiController">

    <padding>
        <Insets top="30" right="50" bottom="30" left="50"/>
    </padding>

    <Label text="BMI CALCULATOR"
           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #326A9C;"/>

    <Label text="Kenali indeks massa tubuhmu"
           style="-fx-font-size: 15px; -fx-text-fill: #71869B;"/>

    <VBox spacing="15"
          maxWidth="550"
          style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30;">

        <Label text="Masukkan Data Kamu"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #326A9C;"/>

        <Label text="Nama"/>
        <TextField fx:id="namaField" promptText="Masukkan nama"/>

        <Label text="Jenis Kelamin"/>
        <ComboBox fx:id="genderComboBox"
                  promptText="Pilih jenis kelamin"
                  maxWidth="Infinity"/>

        <Label text="Berat Badan (kg)"/>
        <TextField fx:id="beratField" promptText="Contoh: 55"/>

        <Label text="Tinggi Badan (cm)"/>
        <TextField fx:id="tinggiField" promptText="Contoh: 165"/>

        <HBox spacing="12">
            <Button text="Hitung BMI"
                    onAction="#handleHitung"
                    maxWidth="Infinity"
                    HBox.hgrow="ALWAYS"
                    style="-fx-background-color: #5B9BD5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12;"/>

            <Button text="Reset"
                    onAction="#handleReset"
                    style="-fx-background-color: #DCEBFA; -fx-text-fill: #326A9C; -fx-background-radius: 10; -fx-padding: 12;"/>
        </HBox>

        <Separator/>

        <Label text="HASIL PERHITUNGAN"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #326A9C;"/>

        <Label fx:id="bmiLabel"
               text="--"
               style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #4D91CC;"/>

        <Label fx:id="kategoriLabel"
               text="Belum ada hasil"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #326A9C;"/>

        <Label fx:id="rekomendasiLabel"
               text="Hasil BMI akan muncul di sini"
               wrapText="true"
               style="-fx-text-fill: #71869B;"/>

    </VBox>

    <Label text="BMI Calculator | JavaFX Project"
           style="-fx-font-size: 12px; -fx-text-fill: #91A9BE;"/>

</VBox>
